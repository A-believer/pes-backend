APP_NAME="PES Backend"
APP_ENV=production
APP_KEY=base64:GENERATE_KEY_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=Europe/London
APP_URL=https://api.expets.co.uk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Production Database (MySQL / MariaDB or PostgreSQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pes_production_db
DB_USERNAME=pes_db_user
DB_PASSWORD=your_secure_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# Production Mail Settings (SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-email@expets.co.uk
MAIL_PASSWORD=your-app-specific-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@expets.co.uk"
MAIL_FROM_NAME="Premium Expert Services"

# Internal Notification Recipient
MAIL_TO=info@expets.co.uk

# Secret Admin Key (Must match VITE_API_KEY / Bearer token used by pes-admin)
ADMIN_API_KEY=YOUR_LONG_SECURE_RANDOM_SECRET_KEY

# Gemini AI Key for Automated Quote Breakdown & Analysis
GEMINI_API_KEY=your-gemini-api-key

# Allowed CORS Origins (comma-separated list, or '*' during transition)
CORS_ALLOWED_ORIGINS="https://expets.co.uk,https://www.expets.co.uk,https://admin.expets.co.uk"
